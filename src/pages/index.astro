>
  <div class="container">
    <h1>Sentieri di Piateda</h1>
    <p>Sito in costruzione: l'elenco dei sentieri arriverà con la prossima versione.</p>
  </div>
  <TrackMap client:only="react" dataUrl="/data/overview.geojson" mode="overview" fit="data" />
</BaseLayout>

<style>
  .container {
    padding-block: var(--space-6);
  }
</style>

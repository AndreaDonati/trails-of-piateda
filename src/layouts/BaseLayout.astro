---
/**
 * Base layout (task 4.2, design D12): document head with sharing metadata,
 * header navigation and footer with the map attribution required by the
 * interactive-map spec. Mobile-first; no fixed widths so 360 px viewports do
 * not scroll horizontally.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { DATA_LICENSE_URL, SITE_NAME, withBase } from '../lib/site';
import { BASEMAP_ATTRIBUTION, TERRAIN_ATTRIBUTION, TERRAIN_PROVIDER } from '../lib/mapConfig';

export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Set when the page body must fill the viewport (overview map). */
  fullBleed?: boolean;
}

const { title, description, ogTitle = title, ogDescription = description, fullBleed = false } =
  Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const navItems = [
  { label: 'Elenco', href: withBase('/') },
  { label: 'Mappa', href: withBase('/mappa/') },
  { label: 'Manutenzione', href: withBase('/manutenzione/') },
  { label: 'Contribuisci', href: withBase('/contribuisci/') },
];

// Astro.url.pathname includes `base` in both dev and build, so compare with the prefixed href.
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <slot name="head" />
  </head>
  <body class:list={{ 'is-full-bleed': fullBleed }}>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={withBase('/')}>{SITE_NAME}</a>
        <nav aria-label="Navigazione principale">
          <ul class="site-nav">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenuto" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__attribution">
          Mappa: {BASEMAP_ATTRIBUTION} | Dati altimetrici:{' '}
          <a href={TERRAIN_PROVIDER.url} rel="noopener" target="_blank">{TERRAIN_ATTRIBUTION}</a>
        </p>
        <p class="site-footer__license">
          Tracce e schede: <a href={DATA_LICENSE_URL} rel="noopener" target="_blank">Licenza dei dati (CC BY 4.0)</a>.
          Statistiche calcolate dal GPX.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .site-main {
    flex: 1 0 auto;
  }

  /* Overview map page: main fills the viewport below the header, footer follows. */
  body.is-full-bleed .site-main {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--header-height));
  }

  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: var(--z-overlay);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    min-height: var(--header-height);
    background: var(--color-primary-strong);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  .site-header__brand {
    color: inherit;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    /* Four items no longer fit on one 360 px line at every text size, so the row wraps
       instead of pushing the header wider than the viewport. */
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit;
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background: rgb(255 255 255 / 18%);
  }

  .site-header :focus-visible {
    outline-color: var(--color-on-primary);
  }

  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer p {
    margin-bottom: var(--space-2);
  }

  .site-footer p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .site-nav {
      gap: var(--space-2);
    }

    .site-nav a {
      font-size: var(--font-size-md);
    }
  }
</style>
